{
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "strictNullChecks": true,
    "paths": {
      "@emails/*": ["./emails/*"],
      "@components/*": ["./components/*"],
      "@static/*": ["./emails/static/*"],
      "@appTypes/*": ["./types/*"] 
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".react-email"]
}
